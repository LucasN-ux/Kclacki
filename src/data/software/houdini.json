{
  "id": "houdini",
  "name": "Houdini",
  "initials": "HO",
  "family": "3d-sculpt",
  "version": "22.0",
  "docUrl": "https://www.sidefx.com/docs/houdini/start/hotkeys.html",
  "verifiedAt": "2026-09-20",
  "undocumented": ["undo", "redo", "save-file", "open-file"],
  "shortcuts": [
    {
      "id": "node-menu",
      "category": "tools",
      "action": {
        "en": "Open the menu of available nodes",
        "fr": "Ouvrir le menu des nœuds disponibles"
      },
      "keys": {
        "win": [["Tab"]],
        "mac": [["Tab"]]
      }
    },
    {
      "id": "orbit-view",
      "category": "navigation",
      "action": {
        "en": "Orbit around the scene",
        "fr": "Orbiter autour de la scène"
      },
      "context": {
        "en": "Viewport",
        "fr": "Vue 3D"
      },
      "keys": {
        "win": [["Space", "MouseLeft"]],
        "mac": [["Space", "MouseLeft"]]
      }
    },
    {
      "id": "pan-view",
      "category": "navigation",
      "action": {
        "en": "Pan the view",
        "fr": "Déplacer la vue"
      },
      "context": {
        "en": "Viewport",
        "fr": "Vue 3D"
      },
      "keys": {
        "win": [["Space", "MouseMiddle"]],
        "mac": [["Space", "MouseMiddle"]]
      }
    },
